name: basic_cleaning
conda_env: conda.yml

entry_points:
  main:
    parameters:
      input_artifact:
        type: string
        description: W&B artifact containing the raw input CSV
      output_artifact:
        type: string
        description: Name of the cleaned W&B artifact
      output_type:
        type: string
        description: W&B type assigned to the cleaned artifact
      output_description:
        type: string
        description: Human-readable artifact description
      min_price:
        type: float
        description: Minimum accepted nightly price in dollars
      max_price:
        type: float
        description: Maximum accepted nightly price in dollars
    command: >-
      python run.py
      --input_artifact {input_artifact}
      --output_artifact {output_artifact}
      --output_type {output_type}
      --output_description "{output_description}"
      --min_price {min_price}
      --max_price {max_price}
